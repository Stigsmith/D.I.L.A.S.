{
  "note": "The real mission list, from Category:Main Objectives on helldivers.wiki.gg. Each mission carries the fronts it appears on and the traits a scoring rule keys on. The traits are ours; the names and the faction split are not.",
  "source": "helldivers.wiki.gg",
  "licence": "CC BY-NC-SA 4.0",
  "traits": {
    "standard": {
      "name": "Standard operation",
      "line": "A full length mission with a main objective. No special loadout needs: bring what the front and planet call for."
    },
    "nest": {
      "name": "Structure demolition",
      "line": "Destroy structures: bug holes, fabricators or buildings. Anything in your kit that closes them saves stratagems."
    },
    "blitz": {
      "name": "Blitz",
      "line": "Destroy every nest or fabricator before the clock runs out. Bring gear that destroys structures fast."
    },
    "wave": {
      "name": "Eradicate",
      "line": "Hold one small area until the kill count is met. Bring crowd clear, sentries and emplacements."
    },
    "defend": {
      "name": "Hold the line",
      "line": "Defend one position against waves. Sentries, mines and emplacements work well here."
    },
    "evacuate": {
      "name": "Escort",
      "line": "Escort civilians across open ground. Smoke blocks line of sight along their route, and area denial keeps enemies off it."
    },
    "carry": {
      "name": "Carry",
      "line": "Carry an objective across the map. It takes a hand, so only one handed weapons can fire while you carry it."
    },
    "hvt": {
      "name": "High value target",
      "line": "Kill a set number of named heavy enemies. Bring anti-tank, plus enough crowd clear to reach them."
    },
    "commando": {
      "name": "Commando",
      "line": "Stratagems work for 1 minute after landing and once more per Helldiver. No reinforcements until you find the pods, 12 in all. Stay quiet: each bot that calls for help raises the threat level."
    }
  },
