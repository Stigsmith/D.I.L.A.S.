node_modules
dist
dist-ssr
*.local

# Screen capture kept in this folder for reference. Too big for git.
*.mp4

# Art is copied out of "All images" by npm run images, so committing it
# would put the same 12.5MB in the repo twice. The manifest is kept.
src/assets/items/
src/assets/warbonds/
src/assets/ui/
src/assets/themes/
public/favicon.svg

# Raw wiki pulls. Cache only, re-fetchable with npm run wiki -- --refresh
.wiki-cache/

# wrangler dev's local state and asset cache. Regenerated on every run.
.wrangler/

# wrangler dev secrets. Production uses `wrangler secret put`. Named before
# Stage 1 needs them, so no secret can ever be committed by accident.
.dev.vars
.dev.vars.*

# Claude Code's per machine settings and its throwaway worktrees.
.claude/settings.local.json
.claude/worktrees/

# Collection exports from Settings, named dilas-YYYY-MM-DD.json (dds-, before the rename). Personal
# state, never project data, and the move to Cloudflare means more of them.
*-20[0-9][0-9]-[0-9][0-9]-[0-9][0-9].json

# Conflict copies a file sync app leaves beside a folder, named like
# "items (# Name clash 2026-09-30 pmrvoiC #)". Found on 30 September 2026
# holding 638 copies of the generated art, which must never reach the repo.
*Name clash*

# The art. Everything in Image Library is extracted from shipped games
# (Helldivers 2, and the Halo and Warhammer crossover skins) or drawn for
# a theme from that art, so none of it goes in the public repository.
# It stays on the curator's machine, where npm run images copies it into
# src/assets for the build; a clone without it runs art free. Taken out
# of the repo and its whole history on 2 October 2026.
Image Library/

# Planet renders from the wiki, fetched by npm run planet-art, copied
# here from the library. Not kept either.
src/assets/planets/
# Armour set renders from the wiki, fetched by npm run armor-art, copied
# here from the library. Game art, not kept either.
src/assets/armor-sets/
