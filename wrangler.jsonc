{
  // How D.D.S. is served. Replaces dragging dist/ onto Netlify.
  //
  // Stage 1 of dds-cloudflare-handover.md: the static site, plus a Worker
  // script answering /api/* and nothing else, plus a D1 database for
  // accounts. Same origin, which is what lets the Content-Security-Policy in
  // public/_headers keep saying connect-src 'self' unchanged.
  //
  // Deploy with `npm run deploy`, which builds first. Cache rules and security
  // headers are in public/_headers, which Vite copies into dist/.
  //
  // Modelled on Enodia's wrangler.jsonc in C:\Dev\Enodia, which carries the
  // longer reasoning behind every key here. Read it before changing one.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "dds",

  // The API, and nothing else, on this origin under /api/*. See
  // run_worker_first below for why "nothing else" is enforced rather than
  // hoped for.
  "main": "worker/index.ts",

  // The newest date the installed runtime supports, so wrangler dev and
  // production behave the same. Past 2025-04-01 is also what makes
  // not_found_handling below behave as described.
  "compatibility_date": "2026-09-23",

  // better-auth reaches for a few node builtins. Without this the Worker fails
  // to start rather than failing at a request, so it is not subtle.
  "compatibility_flags": ["nodejs_compat"],

  // The address until stigly buys a domain. When he does, add
  //   "routes": [{ "pattern": "<the domain>", "custom_domain": true }]
  // and Cloudflare creates the DNS record and the certificate itself.
  "workers_dev": true,

  // 8788, never wrangler's default 8787, because Enodia's wrangler dev uses
  // 8787 and the two run on the same machine.
  //
  // Found on 25 September 2026, the hard way: with Enodia already running,
  // D.D.S.'s wrangler dev bound the same port on Windows and printed "Ready
  // on 8787" while Enodia's server kept answering. Every header read back
  // was Enodia's policy, served over an app that did not have D.D.S.'s
  // files. Nothing errored. Only reading the responses showed it.
  //
  // Set here rather than as a flag so the port belongs to the project, not
  // to whoever types the command.
  "dev": { "port": 8788 },

  "assets": {
    "directory": "./dist",

    // Every route in D.D.S. is a hash, #/tiers/primary, which never reaches
    // the server, so today this only decides what a mistyped path shows: the
    // app, with a 200. It becomes load bearing the day short links like
    // /b/<id> exist, which is Stage 4.
    //
    // Enodia measured the side effect: a missing file also answers with the
    // page and a 200 rather than a 404. Fixing that needs a Worker script in
    // front of every request, which would make every request billable. Not
    // worth it to improve one error message.
    "not_found_handling": "single-page-application",

    // THE LINE THAT KEEPS THIS FREE. Never set it to `true`.
    //
    // Static asset requests are free and unlimited. Worker invocations are
    // 100k a day on the free plan. Assets are served first by default, and
    // this names the only paths that should ever reach the script. Set it to
    // `true` and every icon on every tier row becomes a billable call.
    "run_worker_first": ["/api/*"]
  },

  // Accounts. worker/auth.ts explains the shape.
  //
  // `wrangler dev` ignores `database_id` and runs on a local SQLite file under
  // .wrangler/, so all of this builds and tests with no network at all. Only
  // `--remote` commands and deploys use the id. Created 25 September 2026,
  // region WEUR, beside Enodia's.
  //
  // **The binding is DB, not dds.** `wrangler d1 create` suggests naming the
  // binding after the database, and it did. The code says `env.DB`.
  //
  // **Changing the id orphans the local database.** wrangler dev keys its
  // local file by id, so a new id is a fresh empty database, and the only
  // symptom is a 500 on any request with a session cookie: no such table:
  // session. Re-run `npm run db:migrate` after touching it.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "dds",
      "database_id": "be6b81cb-3738-4d05-9950-375cf9ba6245",
      "migrations_dir": "migrations"
    }
  ],

  // The live party. One Durable Object per party code, holding up to four
  // members and pushing every change to their open connections. See
  // worker/party.ts.
  //
  // **SQLite backed, because the free plan allows nothing else.** Verified
  // on 27 September 2026 against developers.cloudflare.com: key-value backed
  // Durable Objects are paid only. That is what `new_sqlite_classes` says.
  //
  // **The binding is PARTY and the class is Party**, exported from
  // worker/index.ts. Renaming the class later needs a `renamed_classes`
  // migration, not an edit here, or every live party is orphaned.
  "durable_objects": {
    "bindings": [{ "name": "PARTY", "class_name": "Party" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Party"] }],

  // The live war. Every five minutes the Worker fetches who holds what from
  // api.helldivers2.dev and keeps a trimmed snapshot in D1; GET /api/war hands
  // it out. See worker/war.ts, and Stage 6 of dds-cloudflare-handover.md.
  //
  // **Five Cron Triggers per account on the free plan**, and this is one.
  // Enodia uses none. Verified on 29 September 2026 against
  // developers.cloudflare.com/workers/platform/limits, along with the 10 ms of
  // CPU a scheduled run gets, which war.ts measures itself against.
  "triggers": { "crons": ["*/5 * * * *"] },

  // Not secrets: printed on every request to the upstream.
  //
  // **Both are required.** The upstream's README still calls the contact
  // optional; the service itself answers 400 "The X-Super-Client and
  // X-Super-Contact headers are required" without it. Read off a real response
  // on 30 September 2026.
  //
  // SUPER_CLIENT is who is asking: the tool's own address. **Change it with the
  // domain.**
  //
  // SUPER_CONTACT is **a placeholder**, the same public address, because the
  // service will not answer without one. It should be a project address, never
  // a personal one, and which is stigly's to pick: the published repository,
  // or an address on the domain once there is one.
  //
  // MAIL_FROM needs an address on a domain stigly owns, which is Stage 2.
  "vars": {
    "SUPER_CLIENT": "dds.stigly-official.workers.dev",
    "SUPER_CONTACT": "dds.stigly-official.workers.dev"
  }
}
