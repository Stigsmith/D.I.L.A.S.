{
  "name": "dilas",
  "private": true,
  "version": "1.32.0",
  "author": "Stigsmith",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "images": "node scripts/import-images.mjs",
    "validate": "node scripts/validate.mjs",
    "drop": "node scripts/check-drop.mjs",
    "map": "node scripts/check-map.mjs",
    "roles": "node scripts/tag-roles.mjs",
    "prebuild": "npm run images && npm run validate",
    "build": "vite build",
    "postbuild": "node scripts/check-dist.mjs",
    "preview": "vite preview",
    "wiki": "node scripts/fetch-wiki.mjs",
    "difficulty": "node scripts/fetch-difficulty.mjs",
    "missions": "node scripts/fetch-missions.mjs",
    "armor": "node scripts/fetch-armor.mjs",
    "armor-art": "node scripts/fetch-armor.mjs --art",
    "planet-art": "node scripts/fetch-planet-art.mjs",
    "vehicles": "node scripts/add-vehicles.mjs",
    "rules": "node scripts/check-rules.mjs",
    "builds": "node scripts/check-builds.mjs",
    "fonts": "node scripts/fonts.mjs",
    "deploy": "npm run build && node scripts/check-dist.mjs && wrangler deploy",
    "db:schema": "node scripts/db-schema.mjs",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "wrangler d1 migrations apply dilas --local",
    "types": "wrangler types",
    "typecheck": "tsc --noEmit -p tsconfig.worker.json",
    "test:worker": "vitest run --config vitest.worker.config.ts"
  },
  "dependencies": {
    "better-auth": "^1.7.2",
    "drizzle-orm": "^0.45.2",
    "lucide-react": "^0.454.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.22.0",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "drizzle-kit": "^0.31.10",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "typescript": "^7.0.2",
    "vite": "^6.0.0",
    "vitest": "^4.1.11",
    "wrangler": "^4.140.0"
  }
}
